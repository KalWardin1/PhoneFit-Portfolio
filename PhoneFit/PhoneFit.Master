﻿<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Phonefit.master.cs" Inherits="PhoneFit.PhoneFitMaster" %>

<!DOCTYPE html>

<html>

<head runat="server">
     <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%: Page.Title %> — PhoneFit</title>
  <meta name="description"
    content="Browse PhoneFit smartphones, review specifications, compare devices and choose available phone variants." />
  <meta name="theme-color" content="#4F46E5" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&amp;family=Outfit:wght@400;500;600;700&amp;family=Roboto+Mono:wght@400;500&amp;display=swap" />

  <link rel="stylesheet" href="assets/css/styles.css?v=3" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>
     <form id="form1" runat="server">
         <div>
      <a class="skip-link" href="#main">Skip to content</a>

  <div class="utility">
    <div class="container">
      <span class="promo"><span class="tag">PHONEFIT</span>Compare specifications  · Find the phone that fits your needs</span>
      <span class="links"><a href="Contact.aspx">Support</a>South Africa · ZAR</span></div>
  </div>
        <header class="site-header">
    <div class="container" style="display:flex">
      <a href="Home.aspx" class="brand"><span class="brand-mark">P</span> PhoneFit</a>
      <div class="icon-row">
        <asp:HyperLink
            ID="lnkAccount"
            runat="server"
            NavigateUrl="~/Login.aspx"
            CssClass="icon-btn"
            aria-label="Account">

            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21c0-4 4-7 8-7s8 3 8 7" />
            </svg>
        </asp:HyperLink>

        <%--<a href="#" class="icon-btn" aria-label="Wishlist"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg><span class="count">3</span></a>--%>
        <asp:Panel ID="pnlCartIcon" runat="server">

    <a href="cart.aspx" class="icon-btn icon-btn--cart" aria-label="Cart">
        <svg width="20" height="20"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2l-2 5v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7l-2-5z" />
            <path d="M4 7h16" />
            <path d="M16 11a4 4 0 0 1-8 0" />
        </svg>

        <asp:Label
            ID="lblCartCount"
            runat="server"
            CssClass="count"
            Text="0">
        </asp:Label>
    </a>

</asp:Panel>
       <button type="button" class="nav-toggle" aria-label="Open menu" aria-expanded="false"> &#8801;
</button>
      </div>
    </div>
  </header>

    <!-- nav bar beggins -->
  <nav class="nav-bar" aria-label="Primary">
    <div class="container">

        <asp:Panel ID="pnlBrowsePhones" runat="server">
            <a href="shop.aspx" class="all-cats">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="18" x2="21" y2="18" />
                </svg>
                Browse Phones
            </a>
        </asp:Panel>

        <div class="main-nav">
            <a href="Home.aspx">Home</a>

            <asp:HyperLink
                ID="lnkShop"
                runat="server"
                NavigateUrl="~/shop.aspx"
                Text="Shop Phones">
            </asp:HyperLink>

            <asp:HyperLink
                ID="lnkCompare"
                runat="server"
                NavigateUrl="~/ComparePhones.aspx"
                Text="Compare">
            </asp:HyperLink>

            <asp:HyperLink
                ID="lnkMyOrders"
                runat="server"
                NavigateUrl="~/MyOrders.aspx"
                Text="My Orders"
                Visible="false">
            </asp:HyperLink>

            <asp:HyperLink
                ID="lnkCart"
                runat="server"
                NavigateUrl="~/cart.aspx"
                Text="Cart">
            </asp:HyperLink>

            <asp:HyperLink
                ID="lnkManagerDashboard"
                runat="server"
                NavigateUrl="~/Manager.aspx"
                Text="Manager Dashboard"
                Visible="false">
            </asp:HyperLink>

            <a href="Contact.aspx">Contact</a>

            <asp:HyperLink
                ID="lnkLogin"
                runat="server"
                NavigateUrl="~/Login.aspx"
                Text="Login"
                CssClass="Login-trigger-btn">
            </asp:HyperLink>

            <asp:LinkButton
                ID="btnLogout"
                runat="server"
                Text="Logout"
                Visible="false"
                CausesValidation="false"
                OnClick="btnLogout_Click">
            </asp:LinkButton>
        </div>

        <span class="nav-cta">
            <strong>SMARTER</strong>PHONE CHOICES
        </span>

    </div>
</nav>
    <!-- nav bar ends -->

         <!-- Content starts -->
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
         <!-- Content ends -->


         <!--footer starts -->
         <footer class="site-footer">
    <div class="container">
        <div class="footer-grid">

            <div class="footer-brand">
                <div class="mark">
                    <span class="brand-mark">P</span>
                    PhoneFit
                </div>

                <p>
                    Browse and compare smartphones, explore specifications,
                    and choose a device suited to your needs and budget.
                </p>
            </div>

            <div class="footer-col">
                <h4>PhoneFit</h4>
                <ul>
                    <li><a runat="server" href="~/Home.aspx">Home</a></li>
                    <li><a runat="server" href="~/shop.aspx">Shop Phones</a></li>
                    <li><a runat="server" href="~/cart.aspx">Cart</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Account</h4>
                <ul>
                    <li><a runat="server" href="~/Login.aspx">Login</a></li>
                    <li><a runat="server" href="~/Registration.aspx">Register</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Support</h4>
                <ul>
                   <li><a runat="server" href="~/Contact.aspx">Contact Us</a></li>
                </ul>
            </div>

        </div>

        <div class="footer-bottom">
            <span>
                &copy; <%: DateTime.Now.Year %> PhoneFit. All rights reserved.
            </span>

            <span>
                Smartphone catalogue and comparison platform.
            </span>
        </div>
    </div>
</footer>

  <!-- footer ends -->
  <script src="assets/js/main.js" defer></script>
       </div>
    </form>

</body>
</html>